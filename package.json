{
  "name": "novel-auto-generator",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "description": "SillyTavern 扩展插件 — AI 自动续写小说 + TXT 转世界书",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"**/*.js\"",
    "lint:fix": "eslint \"**/*.js\" --fix",
    "format": "prettier --write \"**/*.{js,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,yml,yaml}\""
  },
  "devDependencies": {
    "vitest": "^3.2.1",
    "fake-indexeddb": "^6.0.1",
    "eslint": "^9.23.0",
    "@eslint/js": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "eslint-config-prettier": "^10.1.1"
  }
}
